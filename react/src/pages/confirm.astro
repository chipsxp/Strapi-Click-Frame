---
import ClientLayout from '../layouts/ClientLayout.astro';

const confirmationToken = Astro.url.searchParams.get('confirmation') || Astro.url.searchParams.get('token');
---

<ClientLayout title="Confirming Stash | Photorium">
  <div class="confirm-container">
    <div class="confirm-card">
      <div class="brand">
        <h1>Photorium</h1>
        <p id="status-text">Almost there! Confirm your stash below.</p>
      </div>

      {!confirmationToken ? (
        <div class="error-box">
          <div class="icon">⚠</div>
          <h2>Missing Token</h2>
          <p>Your confirmation link is missing its token. Please check your email or request a new link.</p>
          <a href="/signup" class="retry-btn">Back to Signup</a>
        </div>
      ) : (
        <div id="confirm-box">
          <button
            id="confirm-btn"
            class="login-btn"
            data-token={confirmationToken}
          >
            Confirm My Stash
          </button>
          <p class="hint">Clicking confirms your email and activates your account.</p>
        </div>
      )}

      <div id="success-box" class="success-box hidden">
        <div class="icon">✓</div>
        <h2>Stash Verified!</h2>
        <p>Your recipe is now official. You can now log in to start sharing your art.</p>
        <a href="/login" class="login-btn">Log In</a>
      </div>

      <div id="error-box" class="error-box hidden">
        <div class="icon">⚠</div>
        <h2>Verification Failed</h2>
        <p id="error-desc">Something went wrong.</p>
        <a href="/signup" class="retry-btn">Back to Signup</a>
      </div>
    </div>
  </div>

  <script>
    const confirmBtn = document.getElementById('confirm-btn') as HTMLButtonElement | null;
    const confirmBox = document.getElementById('confirm-box');
    const successBox = document.getElementById('success-box');
    const errorBox = document.getElementById('error-box');
    const errorDesc = document.getElementById('error-desc');

    confirmBtn?.addEventListener('click', async () => {
      const token = confirmBtn.dataset.token;
      if (!token) return;

      confirmBtn.disabled = true;
      confirmBtn.textContent = 'Verifying...';

      try {
        const res = await fetch('/api/confirm-email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token }),
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok) {
          confirmBox?.classList.add('hidden');
          successBox?.classList.remove('hidden');
        } else {
          throw new Error(data.error || 'Verification failed.');
        }
      } catch (err) {
        const message = err instanceof Error ? err.message : 'Verification failed.';
        if (errorDesc) errorDesc.textContent = message;
        confirmBox?.classList.add('hidden');
        errorBox?.classList.remove('hidden');
      } finally {
        confirmBtn.disabled = false;
        confirmBtn.textContent = 'Confirm My Stash';
      }
    });
  </script>

  <style>
    .confirm-container {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 80vh;
      padding: 2rem;
    }

    .confirm-card {
      background: var(--card-bg, #ffffff);
      padding: 3rem;
      border-radius: 2rem;
      box-shadow: 0 20px 40px rgba(0,0,0,0.1);
      width: 100%;
      max-width: 500px;
      border: 2px solid #f0f0f0;
      text-align: center;
    }

    .brand h1 {
      font-size: 2.5rem;
      color: #3d2b1f;
      margin-bottom: 0.5rem;
      font-weight: 800;
    }

    .brand p {
      color: #8b7355;
      font-size: 1.1rem;
      margin-bottom: 2rem;
    }

    .hint {
      color: #8b7355;
      font-size: 0.95rem;
      margin-top: 1rem;
    }

    .success-box h2 {
      color: #2e7d32;
      margin-bottom: 1rem;
    }

    .success-box .icon {
      font-size: 4rem;
      color: #4caf50;
      margin-bottom: 1rem;
    }

    .error-box h2 {
      color: #c62828;
      margin-bottom: 1rem;
    }

    .error-box .icon {
      font-size: 4rem;
      color: #e53935;
      margin-bottom: 1rem;
    }

    .login-btn, .retry-btn {
      display: inline-block;
      margin-top: 2rem;
      padding: 1rem 2rem;
      background: #3d2b1f;
      color: white;
      text-decoration: none;
      border-radius: 1rem;
      font-weight: 700;
      transition: background 0.2s;
      border: none;
      cursor: pointer;
      font-size: 1rem;
    }

    .login-btn:hover {
      background: #4caf50;
    }

    .retry-btn:hover {
      background: #e53935;
    }

    .login-btn:disabled {
      opacity: 0.7;
      cursor: wait;
    }

    .hidden {
      display: none !important;
    }

    p {
      color: #5d4037;
      line-height: 1.6;
    }
  </style>
</ClientLayout>
