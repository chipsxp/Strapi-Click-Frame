---
import ClientLayout from "../layouts/ClientLayout.astro";
import type { StrapiPhoto, StrapiCategory, StrapiMedia } from "../types/strapi";

const { user: initialUser, token } = Astro.locals;

if (!initialUser) {
  return Astro.redirect("/login");
}

const strapiUrl = import.meta.env.STRAPI_URL || "http://localhost:1337";

// Fallback: If role is missing, fetch the full user profile
let user = initialUser;
if (!user.role) {
  try {
    const userRes = await fetch(`${strapiUrl}/api/users/me`, {
      headers: { Authorization: `Bearer ${token}` },
    });
    if (userRes.ok) {
      user = await userRes.json();
    }
  } catch (e) {
    console.error("Failed to fetch user role fallback:", e);
  }
}
const response = await fetch(
  `${strapiUrl}/api/photos?filters[author][id][$eq]=${user.id}&populate[image]=true&populate[categories]=true`,
  {
    headers: {
      Authorization: `Bearer ${token}`,
    },
  },
);

const photosJson = await response.json() as { data: StrapiPhoto[] };
const photos: StrapiPhoto[] = photosJson.data || [];

// Fetch user's categories - Editors see all flavors, regular users see their own
const categoriesUrl = (user.role?.type === "editor" || user.role?.type === "admin")
  ? `${strapiUrl}/api/categories?sort=name:asc`
  : `${strapiUrl}/api/categories?filters[user][id][$eq]=${user.id}&sort=name:asc`;

const categoriesRes = await fetch(categoriesUrl, {
  headers: {
    Authorization: `Bearer ${token}`,
  },
});
const categoriesJson = await categoriesRes.json() as { data: StrapiCategory[] };
const categories: StrapiCategory[] = categoriesJson.data || [];

/**
 * Safely resolves image URLs from Strapi 5 Media objects
 */
function getImageUrl(media: StrapiMedia | undefined | null): string | undefined {
  if (!media) return undefined;
  // Handle direct URL (ImageKit or populated)
  if (media.url) return media.url;
  // Handle Strapi 5 attributes structure
  if (media.data?.attributes?.url) return media.data.attributes.url;
  return undefined;
}

const resolveImageUrl = (url: string | undefined | null) => {
  if (!url) return "/favicon.png";
  return url.startsWith("http") ? url : `${strapiUrl}${url}`;
};
---

<ClientLayout title="Author Dashboard | Photorium">
  <div class="dashboard-container">
    <aside class="sidebar">
      <div class="profile-card">
        <div class="avatar-ring">
          <img
            src={resolveImageUrl(getImageUrl(user.avatar))}
            alt={user.username}
          />
        </div>
        <h2>{user.username}</h2>
        <p class="bio">
          {user.bio || "No bio yet. Add one to spice things up!"}
        </p>

        <div class="stats-mini">
          <div class="stat-item">
            <span class="value">{user.classic_munch_given_total || 0}</span>
            <span class="label">Given</span>
          </div>
          <div class="stat-item">
            <span class="value">{user.cheddar_munch_balance || 0}</span>
            <span class="label">Cheddar</span>
          </div>
        </div>

        {/* Chip Inventory & Status */}
        {(() => {
          const lastMunch = user.last_classic_munch_at ? new Date(user.last_classic_munch_at) : null;
          const today = new Date();
          const isClassicAvailable = !lastMunch || 
            lastMunch.getUTCFullYear() !== today.getUTCFullYear() ||
            lastMunch.getUTCMonth() !== today.getUTCMonth() ||
            lastMunch.getUTCDate() !== today.getUTCDate();
          
          const progressToCheddar = (user.classic_munch_given_total || 0) % 5;
          const chipsToNextCheddar = 5 - progressToCheddar;

          return (
            <div class="inventory-section">
              <h3 class="inventory-title">Your Daily Chips</h3>
              <div class="chip-status-grid">
                <div class={`chip-status-card ${isClassicAvailable ? 'available' : 'used'}`}>
                  <div class="chip-header">
                    <span class="chip-emoji">🍟</span>
                    <span class="status-badge">{isClassicAvailable ? 'Ready' : 'Used'}</span>
                  </div>
                  <span class="chip-name">Classic</span>
                  <p class="chip-desc">
                    {isClassicAvailable 
                      ? "One fresh chip ready to toss!" 
                      : "You've given your daily chip. Refills at midnight UTC."}
                  </p>
                </div>

                <div class={`chip-status-card ${(user.cheddar_munch_balance ?? 0) > 0 ? 'available' : 'empty'}`}>
                  <div class="chip-header">
                    <span class="chip-emoji">🧀</span>
                    <span class="status-badge">{(user.cheddar_munch_balance ?? 0) > 0 ? `${user.cheddar_munch_balance} Left` : 'Empty'}</span>
                  </div>
                  <span class="chip-name">Cheddar</span>
                  <div class="cheddar-progress">
                    <div class="progress-bar">
                      <div class="progress-fill" style={`width: ${(progressToCheddar / 5) * 100}%`}></div>
                    </div>
                    <span class="progress-text">{chipsToNextCheddar} more classics for 1 Cheddar</span>
                  </div>
                </div>
              </div>
            </div>
          );
        })()}

        <button
          id="edit-profile-btn"
          class="secondary-btn"
          style="margin-bottom: 1rem; width: 100%;">Edit Profile</button
        >
        {
          (user.role?.type === "editor" || user.role?.type === "admin") && (
            <button
              id="manage-flavors-btn"
              class="secondary-btn"
              style="margin-bottom: 1rem; width: 100%;"
            >
              Manage Flavors
            </button>
          )
        }
        <button id="logout-btn" class="logout-btn">Log Out</button>
      </div>
    </aside>

    <main class="content">
      <!-- Notification Feed -->
      <div id="notification-feed" class="notification-feed" style="display: none;">
        <div class="notification-header">
          <h3>Recent Sizzles</h3>
          <span class="notification-subtitle">From artists you follow</span>
        </div>
        <div id="notification-list" class="notification-list">
          <!-- Notifications will be injected here -->
        </div>
      </div>

      <header class="section-header">
        <h1>Your Stash</h1>
        <button id="open-upload-btn" class="primary-btn"
          >Toss in the Fryer</button
        >
      </header>

      <div class="photo-grid">
        {
          photos.length > 0 ? (
            photos.map((photo) => (
              <div class="photo-item">
                <a href={`/photo/${photo.documentId}`}>
                  <img
                    src={resolveImageUrl(
                      photo.ik_url || getImageUrl(photo.image)
                    )}
                    alt={photo.title}
                  />
                </a>
                <div class="photo-info">
                  <a
                    href={`/photo/${photo.documentId}`}
                    style="text-decoration: none; color: inherit;"
                  >
                    <h3>{photo.title}</h3>
                  </a>
                  <div class="photo-actions-row">
                    <div class="counts">
                      <span>🍟 {photo.classic_munch_count || 0}</span>
                      <span>🧀 {photo.cheddar_munch_count || 0}</span>
                    </div>
                    <div class="self-service-actions">
                      <button
                        class="edit-photo-btn"
                        data-id={photo.documentId}
                        data-title={photo.title}
                        data-description={photo.description}
                        data-category={photo.categories?.map(c => c.name).join(', ') || ""}
                        title="Edit Photo"
                      >
                        ✏️
                      </button>
                      <button
                        class="delete-photo-btn"
                        data-id={photo.documentId}
                        title="Delete Photo"
                      >
                        🗑️
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            ))
          ) : (
            <div class="empty-state">
              <p>Your stash is empty. Start frying some art!</p>
            </div>
          )
        }
      </div>
    </main>

    <!-- Global Confirmation Modal -->
    <div id="confirm-modal" class="modal">
      <div class="modal-content" style="max-width: 450px;">
        <h2 id="confirm-title">Are you sure?</h2>
        <p id="confirm-message" style="margin-bottom: 2rem;"></p>
        <div class="actions">
          <button type="button" id="confirm-cancel-btn" class="secondary-btn">Cancel</button>
          <button type="button" id="confirm-ok-btn" class="primary-btn" style="background: #d32f2f;">Confirm</button>
        </div>
      </div>
    </div>

    <!-- Manage Flavors Modal -->
    <div id="flavors-modal" class="modal">
      <div class="modal-content" style="max-width: 800px;">
        <h2>Manage Your Flavors</h2>
        <p style="margin-bottom: 1.5rem; color: #666; font-size: 0.9rem;">Rename, merge, or delete categories you've created.</p>
        <div class="flavors-list">
          {categories.length > 0 ? (
            categories.map((cat) => (
              <div class="flavor-card" data-id={cat.documentId}>
                <div class="flavor-info">
                   <input type="text" class="flavor-name-input" value={cat.name} data-original={cat.name} />
                </div>
                <div class="flavor-actions">
                  <button class="rename-flavor-btn" title="Save Rename">💾</button>
                  <div class="merge-zone">
                    <select class="merge-target-select">
                      <option value="">Merge into...</option>
                      {categories.filter((c) => c.documentId !== cat.documentId).map((c) => (
                        <option value={c.documentId}>{c.name}</option>
                      ))}
                    </select>
                    <button class="merge-flavor-btn" title="Merge Content">🤝</button>
                  </div>
                  <button class="delete-flavor-btn" title="Delete Flavor">🗑️</button>
                </div>
              </div>
            ))
          ) : (
            <div class="empty-state">
              <p>You haven't created any flavors yet.</p>
            </div>
          )}
        </div>
        <div class="actions">
          <button type="button" id="close-flavors-btn" class="secondary-btn">Close</button>
        </div>
      </div>
    </div>

    <!-- Profile Edit Modal -->
    <div id="profile-modal" class="modal">
      <div class="modal-content">
        <h2>Profile Settings</h2>
        <form id="profile-form">
          <div class="field">
            <label>Avatar (The Face of the Artist)</label>
            <input type="file" name="avatar" accept="image/*" />
          </div>
          <div class="field">
            <label>Username (Unique Handle)</label>
            <input
              type="text"
              name="username"
              value={user.username || ""}
              placeholder="Artist_Handle"
              required
            />
          </div>
          <div class="field">
            <label>Nickname (Display Name)</label>
            <input
              type="text"
              name="nickname"
              value={user.nickname || ""}
              placeholder="Cool Artist Alias"
            />
          </div>
          <div class="field">
            <label>The Artist's Lore (Bio)</label>
            <textarea name="bio" placeholder="Tell your story..."
              >{user.bio || ""}</textarea
            >
          </div>
          <div class="actions">
            <button type="button" id="close-profile-btn" class="secondary-btn"
              >Cancel</button
            >
            <button type="submit" class="primary-btn">Save Profile</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Upload Modal -->
    <div id="upload-modal" class="modal">
      <div class="modal-content">
        <h2>New Batch</h2>
        <form id="upload-form">
          <div class="field">
            <label>The Goods (Image)</label>
            <input type="file" name="files" required accept="image/*" />
          </div>
          <div class="field">
            <label>Title</label>
            <input
              type="text"
              name="title"
              required
              placeholder="Name your creation"
            />
          </div>
          <div class="field">
            <label>Category (Flavor)</label>
            <input
              type="text"
              name="category"
              required
              placeholder="e.g. Boy Scouts, Panics, Retro"
            />
          </div>
          <div class="field">
            <label>Story (Description)</label>
            <textarea
              name="description"
              required
              placeholder="What's the secret ingredient?"></textarea>
          </div>
          <div class="actions">
            <button type="button" id="close-upload-btn" class="secondary-btn"
              >Cancel</button
            >
            <button type="submit" class="primary-btn">Fry It!</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Edit Photo Modal -->
    <div id="edit-photo-modal" class="modal">
      <div class="modal-content">
        <h2>Edit Photo</h2>
        <form id="edit-photo-form">
          <input type="hidden" name="photoId" id="edit-photo-id" />
          <div class="field">
            <label>Title</label>
            <input
              type="text"
              name="title"
              id="edit-photo-title"
              required
              placeholder="Name your creation"
            />
          </div>
          <div class="field">
            <label>Category (Flavor)</label>
            <input
              type="text"
              name="category"
              id="edit-photo-category"
              required
              placeholder="e.g. Boy Scouts, Panics, Retro"
            />
          </div>
          <div class="field">
            <label>Story (Description)</label>
            <textarea
              name="description"
              id="edit-photo-description"
              required
              placeholder="What's the secret ingredient?"></textarea>
          </div>
          <div class="actions">
            <button
              type="button"
              id="close-edit-photo-btn"
              class="secondary-btn">Cancel</button
            >
            <button type="submit" class="primary-btn">Save Changes</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</ClientLayout>

<script>
  import toast from "react-hot-toast";

  // Logout Logic
  document.getElementById("logout-btn")?.addEventListener("click", async () => {
    await fetch("/api/logout", { method: "POST" });
    window.location.href = "/";
  });

  // Modal Logic Helpers
  const openModal = (id: string) => document.getElementById(id)?.classList.add("open");
  const closeModal = (id: string) => document.getElementById(id)?.classList.remove("open");

  // Simple Themed Confirmation Utility
  const askConfirmation = (title: string, message: string, onConfirm: () => void) => {
    const titleEl = document.getElementById("confirm-title");
    const msgEl = document.getElementById("confirm-message");
    const okBtn = document.getElementById("confirm-ok-btn");
    
    if (titleEl) titleEl.innerText = title;
    if (msgEl) msgEl.innerText = message;
    
    const cleanup = () => {
      closeModal("confirm-modal");
      okBtn?.removeEventListener("click", handleOk);
    };

    const handleOk = () => {
      onConfirm();
      cleanup();
    };

    okBtn?.addEventListener("click", handleOk);
    document.getElementById("confirm-cancel-btn")?.addEventListener("click", cleanup, { once: true });
    
    openModal("confirm-modal");
  };

  // Upload Modal
  document.getElementById("open-upload-btn")?.addEventListener("click", () => openModal("upload-modal"));
  document.getElementById("close-upload-btn")?.addEventListener("click", () => closeModal("upload-modal"));

  // Flavors Modal
  document.getElementById("manage-flavors-btn")?.addEventListener("click", () => openModal("flavors-modal"));
  document.getElementById("close-flavors-btn")?.addEventListener("click", () => closeModal("flavors-modal"));

  // Rename Flavor
  document.querySelectorAll(".rename-flavor-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const card = target.closest(".flavor-card") as HTMLElement;
      const id = card.dataset.id;
      const input = card.querySelector(".flavor-name-input") as HTMLInputElement;
      const newName = input.value.trim();
      const originalName = input.dataset.original;

      if (!id || !newName || newName === originalName) return;

      const toastId = toast.loading("Renaming flavor...");
      try {
        const res = await fetch("/api/rename-category", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ documentId: id, name: newName }),
        });

        if (res.ok) {
          toast.success("Flavor renamed!", { id: toastId });
          input.dataset.original = newName;
          setTimeout(() => window.location.reload(), 1000);
        } else {
          const err = await res.json() as { error?: string };
          throw new Error(err.error || "Failed to rename flavor");
        }
      } catch (err: unknown) {
        const message = err instanceof Error ? err.message : "Network error";
        toast.error(message, { id: toastId });
      }
    });
  });

  // Merge Flavor
  document.querySelectorAll(".merge-flavor-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const card = target.closest(".flavor-card") as HTMLElement;
      const sourceId = card.dataset.id;
      const select = card.querySelector(".merge-target-select") as HTMLSelectElement;
      const targetId = select.value;

      if (!targetId) {
        toast.error("Please select a destination flavor to merge into.");
        return;
      }

      askConfirmation(
        "Merge Flavors",
        "Merge all photos into the destination and delete this flavor? This cannot be undone.",
        async () => {
          const toastId = toast.loading("Merging flavors...");
          try {
            const res = await fetch("/api/merge-category", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ sourceDocumentId: sourceId, targetDocumentId: targetId }),
            });

            if (res.ok) {
              toast.success("Flavors merged successfully!", { id: toastId });
              setTimeout(() => window.location.reload(), 1000);
            } else {
              const err = await res.json() as { error?: string };
              throw new Error(err.error || "Failed to merge flavors");
            }
          } catch (err: unknown) {
            const message = err instanceof Error ? err.message : "Network error";
            toast.error(message, { id: toastId });
          }
        }
      );
    });
  });

  // Delete Flavor
  document.querySelectorAll(".delete-flavor-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const card = target.closest(".flavor-card") as HTMLElement;
      const id = card.dataset.id;

      askConfirmation(
        "Delete Flavor",
        "Are you sure you want to delete this flavor? Photos will become 'Uncategorized'.",
        async () => {
          const toastId = toast.loading("Deleting flavor...");
          try {
            const res = await fetch("/api/delete-category", {
              method: "DELETE",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ documentId: id }),
            });

            if (res.ok) {
              toast.success("Flavor deleted!", { id: toastId });
              setTimeout(() => window.location.reload(), 1000);
            } else {
              const err = await res.json() as { error?: string };
              throw new Error(err.error || "Failed to delete flavor");
            }
          } catch (err: unknown) {
            const message = err instanceof Error ? err.message : "Network error";
            toast.error(message, { id: toastId });
          }
        }
      );
    });
  });

  // Profile Modal
  document.getElementById("edit-profile-btn")?.addEventListener("click", () => openModal("profile-modal"));
  document.getElementById("close-profile-btn")?.addEventListener("click", () => closeModal("profile-modal"));

  const profileForm = document.getElementById("profile-form") as HTMLFormElement;
  profileForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(profileForm);
    const avatarFile = formData.get("avatar") as File;
    const submitBtn = profileForm.querySelector('button[type="submit"]') as HTMLButtonElement;

    try {
      if (submitBtn) submitBtn.disabled = true;
      const toastId = toast.loading("Updating profile...");
      let avatarId = null;

      if (avatarFile && avatarFile.size > 0) {
        const uploadData = new FormData();
        uploadData.append("files", avatarFile);
        const uploadRes = await fetch("/api/upload", { method: "POST", body: uploadData });
        if (!uploadRes.ok) throw new Error("Avatar upload failed");
        const uploadedFiles = await uploadRes.json() as { id: number }[];
        avatarId = uploadedFiles[0].id;
      }

      const updateRes = await fetch("/api/update-profile", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          username: formData.get("username"),
          nickname: formData.get("nickname"),
          bio: formData.get("bio"),
          avatar: avatarId || undefined,
        }),
      });

      if (updateRes.ok) {
        toast.success("Profile updated successfully!", { id: toastId });
        setTimeout(() => window.location.reload(), 1000);
      } else {
        const err = await updateRes.json() as { error?: string };
        throw new Error(err.error || "Unknown error");
      }
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : "Network error";
      toast.error("Failed to update profile: " + message);
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });

  // Upload Logic
  const uploadForm = document.getElementById("upload-form") as HTMLFormElement;
  uploadForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(uploadForm);
    const submitBtn = uploadForm.querySelector('button[type="submit"]') as HTMLButtonElement;

    try {
      if (submitBtn) submitBtn.disabled = true;
      const toastId = toast.loading("Frying photo...");

      const uploadRes = await fetch("/api/upload", { method: "POST", body: formData });
      if (!uploadRes.ok) throw new Error("Upload failed");
      const uploadedFiles = await uploadRes.json() as { id: number }[];
      const fileId = uploadedFiles[0].id;

      const createRes = await fetch("/api/create-photo", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          title: formData.get("title"),
          description: formData.get("description"),
          category: formData.get("category"),
          image: fileId,
        }),
      });

      if (createRes.ok) {
        toast.success("Photo fried successfully!", { id: toastId });
        setTimeout(() => window.location.reload(), 1000);
      } else {
        throw new Error("Failed to save metadata");
      }
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : "Network error";
      toast.error("Something went wrong during upload: " + message);
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });

  // Edit Photo Logic
  const editPhotoForm = document.getElementById("edit-photo-form") as HTMLFormElement;
  document.getElementById("close-edit-photo-btn")?.addEventListener("click", () => closeModal("edit-photo-modal"));

  document.querySelectorAll(".edit-photo-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const { id, title, description, category } = target.dataset;

      (document.getElementById("edit-photo-id") as HTMLInputElement).value = id || "";
      (document.getElementById("edit-photo-title") as HTMLInputElement).value = title || "";
      (document.getElementById("edit-photo-description") as HTMLTextAreaElement).value = description || "";
      
      const categoryInput = document.getElementById("edit-photo-category") as HTMLInputElement;
      categoryInput.value = category || "";
      categoryInput.placeholder = category ? "" : "Please add a category flavor!";

      openModal("edit-photo-modal");
    });
  });

  editPhotoForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(editPhotoForm);
    const submitBtn = editPhotoForm.querySelector('button[type="submit"]') as HTMLButtonElement;

    try {
      if (submitBtn) submitBtn.disabled = true;
      const toastId = toast.loading("Saving changes...");

      const updateRes = await fetch("/api/update-photo", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          photoId: formData.get("photoId"),
          title: formData.get("title"),
          description: formData.get("description"),
          category: formData.get("category"),
        }),
      });

      if (updateRes.ok) {
        toast.success("Photo updated successfully!", { id: toastId });
        setTimeout(() => window.location.reload(), 1000);
      } else {
        const err = await updateRes.json() as { error?: string };
        throw new Error(err.error || "Failed to update photo");
      }
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : "Network error";
      toast.error(message);
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });

  // Delete Photo Logic
  document.querySelectorAll(".delete-photo-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const id = target.dataset.id;

      askConfirmation(
        "Delete Photo",
        "Are you sure you want to delete this photo? This cannot be undone.",
        async () => {
          const toastId = toast.loading("Deleting photo...");
          try {
            const delRes = await fetch("/api/delete-photo", {
              method: "DELETE",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ photoId: id }),
            });

            if (delRes.ok) {
              toast.success("Photo deleted!", { id: toastId });
              setTimeout(() => window.location.reload(), 1000);
            } else {
              const err = await delRes.json() as { error?: string };
              throw new Error(err.error || "Failed to delete photo");
            }
          } catch (err: unknown) {
            const message = err instanceof Error ? err.message : "Network error";
            toast.error(message, { id: toastId });
          }
        }
      );
    });
  });

  // --- Notification Feed Logic ---
  let notifications: any[] = [];
  let dismissedIds: string[] = [];
  try {
    const stored = localStorage.getItem("dismissed_sizzles");
    if (stored) dismissedIds = JSON.parse(stored);
  } catch(e) {}

  const MAX_NOTIFICATIONS = 6;
  const POLLING_INTERVAL = 600000; // Increased to 10 minutes to save API credits
  const IDLE_TIMEOUT = 1800000; // 30 minutes of no mouse/keyboard = stop polling
  let lastActivity = Date.now();

  // Track activity to detect idle state
  const resetActivity = () => { lastActivity = Date.now(); };
  window.addEventListener('mousemove', resetActivity);
  window.addEventListener('keydown', resetActivity);

  const formatTime = (dateStr: string) => {
    const date = new Date(dateStr);
    const now = new Date();
    const diffMs = now.getTime() - date.getTime();
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMins / 60);
    const diffDays = Math.floor(diffHours / 24);

    if (diffMins < 60) return `${diffMins}m ago`;
    if (diffHours < 24) return `${diffHours}h ago`;
    return `${diffDays}d ago`;
  };

  const renderNotifications = () => {
    const listEl = document.getElementById("notification-list");
    const feedEl = document.getElementById("notification-feed");
    
    if (!listEl || !feedEl) return;
    
    if (notifications.length === 0) {
      feedEl.style.display = "none";
      return;
    }

    feedEl.style.display = "block";
    listEl.innerHTML = notifications.map(notif => {
      let message = `<strong>${notif.authorName}</strong> tossed <strong>${notif.title}</strong> into the fryer!`;
      if (notif.type === 'comment') {
        if (notif.notifType === 'reply_to_comment') {
          message = `<strong>${notif.authorName}</strong> replied to your comment on <strong>${notif.title}</strong>!`;
        } else {
          message = `<strong>${notif.authorName}</strong> left a comment on <strong>${notif.title}</strong>!`;
        }
      }

      return `
      <div class="notification-item" data-id="${notif.id}">
        <a href="${notif.url}" class="notif-link" data-notifid="${notif.documentId}" data-notiftype="${notif.type}">
          <img src="${notif.authorAvatar}" class="notif-avatar" alt="${notif.authorName}" />
          <div class="notif-content">
            <span class="notif-text">${message}</span>
            <span class="notif-meta">${formatTime(notif.createdAt)}</span>
          </div>
        </a>
        <button class="notif-dismiss" title="Dismiss">×</button>
      </div>
    `}).join('');

    // Add dismiss listeners
    listEl.querySelectorAll(".notif-dismiss").forEach(btn => {
      btn.addEventListener("click", (e) => {
        const item = (e.currentTarget as HTMLElement).closest(".notification-item") as HTMLElement;
        const id = item.dataset.id;
        if (id) {
          dismissedIds.push(id);
          try {
            // Keep localStorage from growing too large
            if (dismissedIds.length > 50) dismissedIds = dismissedIds.slice(-50);
            localStorage.setItem("dismissed_sizzles", JSON.stringify(dismissedIds));
          } catch(e) {}
        }
        notifications = notifications.filter(n => n.id !== id);
        renderNotifications();
      });
    });

    // Add click listeners to mark comments as read
    listEl.querySelectorAll(".notif-link").forEach(link => {
      link.addEventListener("click", async (e) => {
        const notifType = (e.currentTarget as HTMLElement).dataset.notiftype;
        const notifDocId = (e.currentTarget as HTMLElement).dataset.notifid;
        if (notifType === 'comment' && notifDocId) {
          // Fire and forget fetch to mark as read
          fetch(`/api/mark-notification-read?id=${notifDocId}`, { method: 'POST' }).catch(() => {});
        }
      });
    });
  };

  const pollNotifications = async () => {
    // API SAVER: Don't poll if tab is hidden (minimized or background)
    if (document.hidden) {
      console.log("[API Saver] Tab hidden, skipping poll.");
      return;
    }

    // API SAVER: Don't poll if user is idle for more than 30 mins
    if (Date.now() - lastActivity > IDLE_TIMEOUT) {
      console.log("[API Saver] User idle, skipping poll.");
      return;
    }

    try {
      const [photoRes, commentRes] = await Promise.all([
        fetch("/api/notifications"),
        fetch("/api/comment-notifications")
      ]);

      const photoData = photoRes.ok ? (await photoRes.json()).data : [];
      const commentData = commentRes.ok ? (await commentRes.json()).data : [];
      
      if ((!photoData || photoData.length === 0) && (!commentData || commentData.length === 0)) return;

      const strapiUrl = ""; // Fallback removed to avoid localhost issues in production

      const newPhotos = (photoData || []).map((photo: any) => ({
        documentId: photo.documentId,
        id: `photo_${photo.documentId}`, // Unique ID for feed
        type: 'photo',
        title: photo.title,
        url: `/photo/${photo.documentId}`,
        authorName: photo.author?.username || "An artist",
        authorAvatar: photo.author?.avatar?.url 
          ? (photo.author.avatar.url.startsWith("http") ? photo.author.avatar.url : (strapiUrl ? `${strapiUrl}${photo.author.avatar.url}` : photo.author.avatar.url))
          : "/favicon.png",
        createdAt: photo.createdAt
      }));

      const newComments = (commentData || []).map((notif: any) => ({
        documentId: notif.documentId,
        id: `comment_${notif.documentId}`, // Unique ID for feed
        type: 'comment',
        title: notif.photo?.title || "your photo",
        url: `/photo/${notif.photo?.documentId || ''}`,
        authorName: notif.sender?.username || "Someone",
        authorAvatar: notif.sender?.avatar?.url 
          ? (notif.sender.avatar.url.startsWith("http") ? notif.sender.avatar.url : (strapiUrl ? `${strapiUrl}${notif.sender.avatar.url}` : notif.sender.avatar.url))
          : "/favicon.png",
        createdAt: notif.createdAt,
        notifType: notif.type
      }));

      const allNewItems = [...newPhotos, ...newComments].sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

      // Merge and unique by id, keeping newest, and filter out dismissed
      const seenIds = new Set(notifications.map(n => n.id));
      const freshItems = allNewItems.filter((n: any) => !seenIds.has(n.id) && !dismissedIds.includes(n.id));

      if (freshItems.length > 0) {
        // Since we have fresh notifications, update the lastViewed timestamp to clear Navbar dot
        localStorage.setItem('lastViewedFollowingFeed', new Date().toISOString());
        notifications = [...freshItems, ...notifications].slice(0, MAX_NOTIFICATIONS);
        renderNotifications();
      }
    } catch (err) {
      console.error("Polling error:", err);
    }
  };

  // Initial poll and start interval
  pollNotifications();
  setInterval(pollNotifications, POLLING_INTERVAL);

  // API SAVER: When user comes back to the tab after a long time, refresh once
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) {
      console.log("[API Saver] Tab focused, refreshing feed.");
      pollNotifications();
    }
  });
</script>

