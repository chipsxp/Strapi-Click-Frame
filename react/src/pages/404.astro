---
import ClientLayout from '../layouts/ClientLayout.astro';
---

<ClientLayout title="404 - Flavor Not Found | Photorium">
  <div class="error-container">
    <div class="error-card">
      <div class="empty-frame">
        <div class="inner-frame">
          <span class="lost-symbol">?</span>
        </div>
      </div>
      
      <h1>404</h1>
      <h2>This Flavor is Missing!</h2>
      <p>We searched the entire kitchen, but we couldn't find the page you're looking for. It might have been devoured or moved to a different stash.</p>
      
      <div class="actions">
        <a href="/" class="home-btn">Return to Gallery</a>
      </div>
    </div>
  </div>
</ClientLayout>

<style>
  .error-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
    padding: 2rem;
  }

  .error-card {
    background: var(--card-bg, #ffffff);
    padding: 4rem 3rem;
    border-radius: 2.5rem;
    box-shadow: 0 30px 60px rgba(0,0,0,0.12);
    width: 100%;
    max-width: 600px;
    text-align: center;
    border: 1px solid var(--border-color, #eee);
  }

  .empty-frame {
    width: 150px;
    height: 150px;
    margin: 0 auto 2.5rem;
    background: #f8f9fa;
    border: 10px solid #3d2b1f;
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 10px 20px rgba(0,0,0,0.05);
    position: relative;
  }

  .inner-frame {
    width: 80%;
    height: 80%;
    border: 2px dashed #8b7355;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
  }

  .lost-symbol {
    font-size: 4rem;
    font-weight: 900;
    color: #ffc107;
    animation: bounce 2s infinite ease-in-out;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }

  h1 {
    font-size: 6rem;
    margin: 0;
    line-height: 1;
    background: linear-gradient(135deg, #3d2b1f, #8b7355);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 900;
  }

  h2 {
    font-size: 2rem;
    color: #3d2b1f;
    margin: 1rem 0;
    font-weight: 800;
  }

  p {
    color: #8b7355;
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 3rem;
  }

  .home-btn {
    display: inline-block;
    padding: 1.25rem 2.5rem;
    background: #3d2b1f;
    color: #fff;
    text-decoration: none;
    border-radius: 1.25rem;
    font-weight: 800;
    font-size: 1.1rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 20px rgba(61, 43, 31, 0.2);
  }

  .home-btn:hover {
    background: #ffc107;
    color: #3d2b1f;
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(255, 193, 7, 0.3);
  }

  [data-theme="dark"] .error-card {
    background: #1e1e1e;
    border-color: #333;
  }

  [data-theme="dark"] .empty-frame {
    background: #2a2a2a;
    border-color: #ffc107;
  }

  [data-theme="dark"] .lost-symbol {
    color: #ffc107;
  }

  [data-theme="dark"] h2 {
    color: #f5f5f5;
  }
</style>
